# TEMPLATE ONLY: copy to .env in this same folder for a new setup.
# Edit only the root .env. Restart both servers after changes.

# PRIVATE: backend settings (never prefix these with VITE_)
MONGODB_URI=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Entire JSON private_key value in quotes, with \n escapes, no trailing comma.
FIREBASE_PRIVATE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PORT=5000
CLIENT_ORIGIN=http://localhost:8080
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=llama3.2-vision
# Private FastAPI connection. Use the same long random token in both services.
VISION_SERVICE_URL=http://127.0.0.1:8000
VISION_SERVICE_TOKEN=

# PUBLIC: Firebase web app settings (visible in the browser)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Leave blank locally; set your backend URL plus /api when deploying separately.
VITE_API_URL=
